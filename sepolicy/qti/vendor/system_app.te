allow system_app cgroup:dir search;
allow system_app hal_audio_default:binder call;
allow system_app hal_bootctl_default:binder call;
allow system_app hal_nfc_default:binder call;
allow system_app hal_sensors_default:binder call;

allow system_app vendor_hal_usb_qti:binder call;
allow system_app hal_wifi_supplicant_default:binder call;
allow system_app hal_wifi_default:binder call;
allow system_app hal_vibrator_default:binder call;
allow system_app hal_thermal_default:binder call;

allow system_app vold:binder call;

hal_client_domain(system_app, hal_health)
hal_client_domain(system_app, hal_memtrack)
hal_client_domain(system_app, hal_power)
r_dir_file(system_app, vendor_sysfs_usb_supply)

# DeviceSettings: touchpanel game-mode/edge-touch toggles and vibrator
# strength control read and write proc/sysfs nodes directly.
allow system_app vendor_proc_display:dir r_dir_perms;
allow system_app vendor_proc_display:file rw_file_perms;
allow system_app sysfs_vibrator:dir r_dir_perms;
allow system_app sysfs_vibrator:file rw_file_perms;

# DeviceSettings: USB2 fast-charge toggle writes the oplus_chg module's
# own force_fast_charge/ffc_val module_params directly (see
# drivers/power/oplus_chg/oplus_charger.c); these are generically labeled
# sysfs by default with no dedicated type, unlike the vibrator node above.
allow system_app vendor_sysfs_oplus_chg_params:dir r_dir_perms;
allow system_app vendor_sysfs_oplus_chg_params:file rw_file_perms;