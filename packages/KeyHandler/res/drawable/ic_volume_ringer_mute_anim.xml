<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_volume_ringer_mute">
    <!-- Speaker body: Tilt backward & elastic vertical silence compression -->
    <target android:name="mute_body">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt"
            name="android:animation">
            <set android:ordering="together">
                <set android:ordering="sequentially">
                    <objectAnimator
                        android:propertyName="rotation"
                        android:valueFrom="0" android:valueTo="-10"
                        android:duration="90"
                        android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <objectAnimator
                        android:propertyName="rotation"
                        android:valueFrom="-10" android:valueTo="6"
                        android:duration="110"
                        android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <objectAnimator
                        android:propertyName="rotation"
                        android:valueFrom="6" android:valueTo="0"
                        android:duration="120"
                        android:interpolator="@android:interpolator/decelerate_cubic" />
                </set>
                <set android:ordering="sequentially">
                    <objectAnimator
                        android:propertyName="scaleY"
                        android:valueFrom="1.0" android:valueTo="0.84"
                        android:duration="100"
                        android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <objectAnimator
                        android:propertyName="scaleY"
                        android:valueFrom="0.84" android:valueTo="1.08"
                        android:duration="120"
                        android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <objectAnimator
                        android:propertyName="scaleY"
                        android:valueFrom="1.08" android:valueTo="1.0"
                        android:duration="100"
                        android:interpolator="@android:interpolator/decelerate_cubic" />
                </set>
            </set>
        </aapt:attr>
    </target>

    <!-- Slash line: Diagonal Blade Strike & Scale Snap -->
    <target android:name="mute_slash">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt"
            name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="0.0" android:valueTo="1.0"
                android:duration="220" android:valueType="floatType"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>

    <!-- Slash group: Elastic Blade Scale Snap -->
    <target android:name="slash_group">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt"
            name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.4" android:valueTo="1.12"
                    android:duration="180"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="1.12" android:valueTo="1.0"
                    android:duration="100"
                    android:interpolator="@android:interpolator/decelerate_cubic" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
