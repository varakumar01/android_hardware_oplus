<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0
     Alarm animation:
     - Clock body shakes vigorously (rotation wiggle)
     - Top alarm waves blink and pulse
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_alarm">
    <target android:name="clock_body">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="rotation"
                    android:valueFrom="0" android:valueTo="-10"
                    android:duration="45"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="rotation"
                    android:valueFrom="-10" android:valueTo="10"
                    android:duration="45"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="rotation"
                    android:valueFrom="10" android:valueTo="-7"
                    android:duration="45"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="rotation"
                    android:valueFrom="-7" android:valueTo="7"
                    android:duration="45"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="rotation"
                    android:valueFrom="7" android:valueTo="-4"
                    android:duration="50"
                    android:interpolator="@android:interpolator/decelerate_cubic" />
                <objectAnimator android:propertyName="rotation"
                    android:valueFrom="-4" android:valueTo="4"
                    android:duration="50"
                    android:interpolator="@android:interpolator/decelerate_cubic" />
                <objectAnimator android:propertyName="rotation"
                    android:valueFrom="4" android:valueTo="0"
                    android:duration="50"
                    android:interpolator="@android:interpolator/decelerate_cubic" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="alarm_waves">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="scaleX"
                    android:valueFrom="0.8" android:valueTo="1.25"
                    android:duration="280"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator android:propertyName="scaleY"
                    android:valueFrom="0.8" android:valueTo="1.25"
                    android:duration="280"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator android:propertyName="alpha"
                    android:valueFrom="0.3" android:valueTo="1.0"
                    android:duration="200"
                    android:interpolator="@android:interpolator/decelerate_cubic" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
