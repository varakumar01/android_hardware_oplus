<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alert_slider_dialog"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_alignParentTop="true"
    android:padding="8dp"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:theme="@style/alert_slider_theme">

    <!-- Layer 1: Glow / Bloom View (Bottom Layer - Animated Gaussian Blur Bloom) -->
    <View
        android:id="@+id/alert_slider_glow"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:clipToOutline="false" />

    <!-- Layer 2: Capsule View (Middle Layer - Main Rounded Background) -->
    <LinearLayout
        android:id="@+id/alert_slider_view"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipToOutline="true"
        android:clipChildren="true">

        <!-- Layer 3: Icon Container (Top Layer Left - Fixed 48dp x 48dp) -->
        <FrameLayout
            android:id="@+id/alert_slider_icon_container"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical">

            <ImageView
                android:id="@+id/alert_slider_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/alert_slider_emoji_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="20sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Layer 4: Text Container (Top Layer Right - Reveal / Hide Text Region) -->
        <FrameLayout
            android:id="@+id/alert_slider_text_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:paddingStart="0dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/alert_slider_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:fontFamily="@*android:string/config_headlineFontFamilyMedium"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="@dimen/alert_slider_text_size"
                android:scrollHorizontally="true"
                android:ellipsize="marquee"
                android:lines="1" />

        </FrameLayout>
    </LinearLayout>
</FrameLayout>
